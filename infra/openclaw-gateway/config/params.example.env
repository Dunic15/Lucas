# Copy to config/params.env and fill in. NON-SECRET values only — secrets go to
# SSM via scripts/put-secrets.sh, never here. config/params.env is gitignored.
#
# No account ids, tokens, or keys belong in this file.

# --- AWS target (a DEV account/region) ---------------------------------------
AWS_REGION=eu-central-1

# --- Networking (from your dev/default VPC) ----------------------------------
VpcId=vpc-REPLACE
SubnetId=subnet-REPLACE            # a PUBLIC subnet in the AZ below
AvailabilityZone=eu-central-1a     # MUST match the subnet's AZ

# --- Instance ----------------------------------------------------------------
EnvironmentName=dev
NamePrefix=laura-openclaw-gw-dev
InstanceType=t4g.small

# --- OpenClaw image: PINNED digest, never :latest ----------------------------
# Resolve the digest for the version you want, e.g.:
#   docker buildx imagetools inspect ghcr.io/openclaw/openclaw:2026.2.26
# then paste the full ref below.
OpenClawImage=ghcr.io/openclaw/openclaw:2026.2.26@sha256:REPLACE_WITH_64_HEX_DIGEST

# --- Storage + logs ----------------------------------------------------------
DataVolumeSizeGb=20
DataVolumeSnapshotId=             # set to snap-... only when restoring
LogRetentionInDays=30

# --- Secrets location + ingress ----------------------------------------------
SecretsPathPrefix=/laura/dev/openclaw
# Default 127.0.0.1/32 = ingress CLOSED (use the Cloudflare Tunnel path).
# For the Caddy custom-domain path, set to a single admin IP, e.g. 203.0.113.7/32.
AllowedHttpsCidr=127.0.0.1/32
