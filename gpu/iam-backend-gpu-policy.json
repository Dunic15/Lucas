{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartStopOnlyTheLauraGpuBox",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances"],
      "Resource": "arn:aws:ec2:eu-central-1:836739852304:instance/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/Name": "laura-gpu" }
      }
    }
  ]
}
