# ─────────────────────────────────────────────────────────────
# Callable AI Process Avatar — environment template
# Copy to .env:   cp .env.example .env
# NEVER commit the real .env (it's gitignored).
# ─────────────────────────────────────────────────────────────
#
# YOU DON'T NEED ANY KEYS TO RUN THE DEMO.
# With an empty .env the demo console runs in a free, offline "stub" mode.
# To get REAL Claude-quality answers, paste ONE key (ANTHROPIC_API_KEY) below —
# that's the whole "insert the API key and it works" step. Everything else is
# only for the optional live-in-a-real-meeting path (bottom of this file).

# ─────────────────── THE ONE KEY THAT MATTERS ───────────────────
# Get one at https://console.anthropic.com/  → paste it here.
# Leave BRAIN_PROVIDER=anthropic; with no key it auto-falls back to the free stub.
BRAIN_PROVIDER=anthropic                # anthropic | groq | ollama | stub
# sk-ant-...   — leave blank to run free. (Comment must stay on its own line:
# python-dotenv treats an inline comment after an empty value as the VALUE,
# which breaks the zero-key stub fallback with an auth error.)
ANTHROPIC_API_KEY=
# Model tiering:
#   BRAIN_MODEL         — post-meeting QUALITY path (summary/artifact). Sonnet.
#   BRAIN_MODEL_FAST    — LIVE spoken path (low latency). Claude Haiku is the safe
#                         default for demos/production. Do NOT put a slow model here.
#   BRAIN_MODEL_COMPLEX — clearly-analytical live asks (compare/analyze/plan) route
#                         to this Claude model directly; more reliable than the fast
#                         model and dodges Groq's rate limits. Haiku keeps it snappy.
BRAIN_MODEL=claude-sonnet-5
BRAIN_MODEL_FAST=claude-haiku-4-5
BRAIN_MODEL_COMPLEX=claude-haiku-4-5
# Optional split: keep the LIVE path on a fast provider while the post-meeting
# artifact uses Claude quality. Empty = same provider everywhere. Prod runs
# BRAIN_PROVIDER_POST=anthropic so summaries are always Claude-grade.
BRAIN_PROVIDER_POST=

# --- Groq (OPTIONAL fast live provider) ---
# Groq serves cheap/fast open models via an OpenAI-compatible API. It's optional:
# set BRAIN_PROVIDER=groq to use it on the LIVE path. Because Groq's free tier
# rate-limits (HTTP 429) under load, a circuit breaker automatically routes live
# answers to Claude Haiku for a cooldown when Groq 429s — so Haiku is the stable
# default and Groq is a speed bonus, never a hard dependency. Web search NEVER
# uses Groq (it's Claude's native web_search — see LIVE_SEARCH_MODEL below).
GROQ_API_KEY=
GROQ_BASE=https://api.groq.com/openai/v1

# --- Which face renders as the bot camera ---
#   talk  = open-source TalkingHead + free TTS (default; key-free, what prod runs)
#   avatar = Anam (paid photoreal face + voice)
# Same {type:"speak"} websocket contract either way, so switching is env-only.
AVATAR_PAGE=talk

# ─────────────────── Embeddings (RAG retrieval) ──────────────────
# hash = free & offline (default). local = free semantic (pip install fastembed).
# voyage = best quality (needs a key).
EMBEDDING_PROVIDER=hash                 # hash | local | voyage
# only if EMBEDDING_PROVIDER=voyage (same rule: no inline comment on empty values)
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3

# ─────────────────── Free local brain (optional) ─────────────────
# Set BRAIN_PROVIDER=ollama to use a local model instead of Claude.
#   1) install Ollama  2) `ollama run llama3.2`  3) set BRAIN_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ══════════════════════════════════════════════════════════════
# BELOW: only needed for the LIVE meeting demo (a face in a real
# Zoom/Meet/Teams call). The demo console above needs none of it.
# ══════════════════════════════════════════════════════════════

# --- Meeting entry / ears (Recall.ai) — required for the LIVE in-call agent ---
# Recall is the only vendor that can BOTH stream a live transcript AND render the
# avatar as the bot's camera. Needed for a real "avatar inside Zoom" demo.
# Paste a Recall API Key here, not a Workspace Secret / webhook secret.
# If it starts with whsec_, it is the wrong value for API authentication.
RECALL_API_KEY=
# Region of your Recall workspace. Prod runs eu-central-1; match your workspace.
RECALL_API_BASE=https://eu-central-1.recall.ai
# Optional: paste the whsec_ Workspace Secret here if you want this app to
# verify incoming Recall webhook signatures.
RECALL_WEBHOOK_SECRET=
# Live transcription. recallai is fastest but low-latency mode is English-only.
# Use elevenlabs for better multilingual/accent handling after adding the
# ElevenLabs Speech-to-Text key in the Recall transcription dashboard.
RECALL_TRANSCRIPTION_PROVIDER=recallai    # recallai | elevenlabs
RECALL_TRANSCRIPTION_MODE=prioritize_low_latency
RECALL_TRANSCRIPTION_LANGUAGE_CODE=en
ELEVENLABS_TRANSCRIPTION_MODEL=scribe_v2_realtime
ELEVENLABS_TRANSCRIPTION_LANGUAGE_CODE=

# --- Calendar auto-join (optional) ---
# Google OAuth connects Laura's calendar to Recall Calendar V2. In Google Cloud,
# add this redirect URI:  https://YOUR_URL/oauth/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# Optional CSRF token for the OAuth redirect; set any long random string.
CALENDAR_OAUTH_STATE=
# Only meetings that invite one of these emails will schedule Laura.
CALENDAR_INVITE_EMAILS=laura.ai.122222@gmail.com

# --- Meeting transcription via Granola (POST-MEETING ONLY, optional) ---
# Granola gives finished transcripts of meetings you already recorded with it —
# a keyless-vendor path to the summary/checklist/email WITHOUT Recall/Anam.
# It CANNOT join a call or render an avatar, so it can't power the live agent.
# Key: Granola desktop app → Settings → Connectors → API keys (starts with grn_).
GRANOLA_API_KEY=
GRANOLA_API_BASE=https://api.granola.ai

# --- Speaker diarization validation (OFFLINE ONLY, optional) ---
# Used solely by scripts/diarize_recording.py (stage 0 of docs/DIARIZATION.md)
# to test shared-mic speaker attribution on recordings. The backend/live path
# never reads this key. Account has 100 free hours (dashboard.pyannote.ai).
PYANNOTE_API_KEY=

# --- Face + voice (Anam renders the avatar; ElevenLabs is its voice) ---
# GLOBAL DEFAULTS — a single avatar can override them in its avatar.yaml.
ANAM_API_KEY=
ANAM_AVATAR_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Used when the primary voice can't synthesize (plan tier/licensing). Any
# premade voice id works on the free plan.
ELEVENLABS_FALLBACK_VOICE_ID=

# --- Photoreal avatar (Stage 2, optional; only when AVATAR_PAGE=photoreal) ---
# GPU_STREAM_URL: websocket of the GPU streaming server (gpu/server.py), e.g.
#   wss://gpu.lauravatar.com/stream. Empty = photoreal page shows a static
#   portrait (still speaks). GPU_INSTANCE_ID: an EC2 box the backend starts on
#   session begin and stops GPU_IDLE_STOP_MINUTES after the last session ends
#   (keep it STOPPED, not terminated). Empty = feature off (manual launch only).
GPU_STREAM_URL=
GPU_INSTANCE_ID=
GPU_AWS_REGION=eu-central-1
GPU_IDLE_STOP_MINUTES=10

# --- Public HTTPS URL of THIS server (Recall must reach the webhook + avatar page) ---
# For local live-meeting testing, run `ngrok http 8000` and paste the HTTPS URL.
PUBLIC_BASE_URL=https://your-ngrok-or-deploy-url

# --- Workflow actions (optional — actually send the follow-up email / Slack) ---
# SendGrid ($5k startup credits) for email; Slack incoming webhook for the checklist.
SENDGRID_API_KEY=
MAIL_FROM=
SLACK_WEBHOOK_URL=

# --- Avatar behaviour (GLOBAL DEFAULTS; per-avatar overrides in avatar.yaml) ---
# Laura ALWAYS tracks the whole meeting silently (MeetingState) — the wake word
# only gates whether she SPEAKS. The wake word is optional and configurable:
WAKE_WORDS=laura
# false (default) = she answers any groundable question without her name (the
# in-stream SKIP gate + cooldown keep her from interjecting). true = require her
# name first. Either way the silent tracking + closing intervention still run.
REQUIRE_WAKE_WORD=false
SPEAK_COOLDOWN_SECONDS=8
# LEGACY — no effect on the live streaming path (superseded by the in-stream SKIP
# gate). Kept for back-compat only.
MIN_CONFIDENCE=0.55
# Autopilot (Laura acts between meetings; ALL OFF by default).
# AUTOPILOT_DELIVER=true auto-sends the follow-up email (to AUTOPILOT_DELIVER_TO,
# comma-separated) + Slack summary when a meeting ends. AUTOPILOT_BRIEF=true
# sends the "still open from last time" brief when a known meeting starts.
# AUTOPILOT_NUDGE=true posts a Slack digest of open items every NUDGE_HOURS.
AUTOPILOT_DELIVER=false
AUTOPILOT_DELIVER_TO=
AUTOPILOT_BRIEF=false
AUTOPILOT_BRIEF_TO=
AUTOPILOT_NUDGE=false
AUTOPILOT_NUDGE_HOURS=24

# General intelligence on the live path: questions that want fresh/current info
# route to Claude's NATIVE web_search tool (never Groq). Haiku by default keeps
# the spoken answer fast; set claude-sonnet-5 for deeper search when you can wait.
# It falls back to a knowledge answer if search returns nothing. Retrieved docs
# are only injected when they actually match the question (RAG_MIN_CONTEXT_SCORE).
LIVE_SEARCH_ENABLED=true
LIVE_SEARCH_MODEL=claude-haiku-4-5
RAG_MIN_CONTEXT_SCORE=0.10

# Proactive intervention: flag ONE missing step as the meeting wraps up (fires
# once, needs high confidence). Set PROACTIVE_ENABLED=false to disable.
PROACTIVE_ENABLED=true
PROACTIVE_MIN_CONFIDENCE=0.7

# Voice dismissal: "Laura, you can leave" makes her say goodbye and end the
# session (bot leaves the call, artifact is built, billing stops). The grace
# delay lets the goodbye audio finish before the bot disconnects.
LEAVE_ON_COMMAND=true
LEAVE_GRACE_SECONDS=2.5

# --- Server ---
HOST=127.0.0.1
PORT=8000

# ── Cedric integration (fork additions — Cedric X Laura project) ──
# Avatar used when a session/dispatch doesn't name one (set to "cedric").
DEFAULT_AVATAR_ID=laura
# Bearer token required on /sessions/* and /ledger. Empty = open (local demo).
LAURA_API_TOKEN=
# HMAC key + bearer for callbacks POSTed to a session's callback_url
# (match Cedric's LAURA_WEBHOOK_SECRET / LAURA_WEBHOOK_TOKEN).
LAURA_WEBHOOK_SECRET=
LAURA_WEBHOOK_TOKEN=
# Bearer presented when fetching a session's context_url at join time
# (match Cedric's LAURA_CONTEXT_TOKEN).
LAURA_CONTEXT_TOKEN=
# Per-request timeout for outbound callbacks/context fetches (seconds).
CALLBACK_TIMEOUT_SECONDS=10.0
