# ─────────────────────────────────────────────────────────────
# Callable AI Process Avatar — environment template
# Copy to .env:   cp .env.example .env
# NEVER commit the real .env (it's gitignored).
# ─────────────────────────────────────────────────────────────
#
# YOU DON'T NEED ANY KEYS TO RUN THE DEMO.
# With an empty .env the demo console runs in a free, offline "stub" mode.
# To get REAL Claude-quality answers, paste ONE key (ANTHROPIC_API_KEY) below —
# that's the whole "insert the API key and it works" step. Everything else is
# only for the optional live-in-a-real-meeting path (bottom of this file).

# ─────────────────── THE ONE KEY THAT MATTERS ───────────────────
# Get one at https://console.anthropic.com/  → paste it here.
# Leave BRAIN_PROVIDER=anthropic; with no key it auto-falls back to the free stub.
BRAIN_PROVIDER=anthropic                # anthropic | cerebras | groq | ollama | stub
# sk-ant-...   — leave blank to run free. (Comment must stay on its own line:
# python-dotenv treats an inline comment after an empty value as the VALUE,
# which breaks the zero-key stub fallback with an auth error.)
ANTHROPIC_API_KEY=
# Model tiering:
#   BRAIN_MODEL         — post-meeting QUALITY path (summary/artifact). Sonnet.
#   BRAIN_MODEL_FAST    — LIVE spoken path (low latency). Claude Haiku is the safe
#                         default for demos/production. Do NOT put a slow model here.
#   BRAIN_MODEL_COMPLEX — clearly-analytical live asks (compare/analyze/plan) route
#                         to this Claude model directly; more reliable than the fast
#                         model and dodges Groq's rate limits. Haiku keeps it snappy.
BRAIN_MODEL=claude-sonnet-5
BRAIN_MODEL_FAST=claude-haiku-4-5
BRAIN_MODEL_COMPLEX=claude-haiku-4-5
# Optional split: keep the LIVE path on a fast provider while the post-meeting
# artifact uses Claude quality. Empty = same provider everywhere. Prod runs
# BRAIN_PROVIDER_POST=anthropic so summaries are always Claude-grade.
BRAIN_PROVIDER_POST=

# --- Cerebras (fastest live provider — what PROD runs today) ---
# Cerebras serves open models over the same OpenAI-compatible wire format as Groq,
# but with the fastest first-token latency available (~0.17s). Prod runs
# BRAIN_PROVIDER=cerebras + BRAIN_MODEL_FAST=gemma-4-31b on the LIVE spoken path,
# with BRAIN_PROVIDER_POST=anthropic (Sonnet 5) for the post-meeting artifact.
# NOTE: this consumes Cerebras credits on every live answer. If it fails or
# rate-limits, the same circuit breaker below routes live answers to Claude Haiku.
# (History: Cerebras used to be smuggled in via GROQ_BASE=https://api.cerebras.ai/v1
# with the Cerebras key in GROQ_API_KEY — it is now a first-class provider.)
CEREBRAS_API_KEY=
CEREBRAS_BASE=https://api.cerebras.ai/v1

# --- Groq (OPTIONAL fast live provider) ---
# Groq serves cheap/fast open models via an OpenAI-compatible API. It's optional:
# set BRAIN_PROVIDER=groq to use it on the LIVE path. Because Groq's free tier
# rate-limits (HTTP 429) under load, a circuit breaker automatically routes live
# answers to Claude Haiku for a cooldown when Groq 429s — so Haiku is the stable
# default and Groq is a speed bonus, never a hard dependency. Web search NEVER
# uses a fast provider (it's Claude's native web_search — see LIVE_SEARCH_MODEL).
GROQ_API_KEY=
GROQ_BASE=https://api.groq.com/openai/v1

# --- Which face renders as the bot camera ---
#   talk  = open-source TalkingHead + free TTS (default; key-free, what prod runs)
#   avatar = Anam (paid photoreal face + voice)
# Same {type:"speak"} websocket contract either way, so switching is env-only.
AVATAR_PAGE=talk

# ─────────────────── Embeddings (RAG retrieval) ──────────────────
# hash = free & offline (default). local = free semantic (pip install fastembed).
# voyage = best quality (needs a key).
EMBEDDING_PROVIDER=hash                 # hash | local | voyage
# only if EMBEDDING_PROVIDER=voyage (same rule: no inline comment on empty values)
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3

# ─────────────────── Free local brain (optional) ─────────────────
# Set BRAIN_PROVIDER=ollama to use a local model instead of Claude.
#   1) install Ollama  2) `ollama run llama3.2`  3) set BRAIN_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ══════════════════════════════════════════════════════════════
# BELOW: only needed for the LIVE meeting demo (a face in a real
# Zoom/Meet/Teams call). The demo console above needs none of it.
# ══════════════════════════════════════════════════════════════

# --- Meeting entry / ears (Recall.ai) — required for the LIVE in-call agent ---
# Recall is the only vendor that can BOTH stream a live transcript AND render the
# avatar as the bot's camera. Needed for a real "avatar inside Zoom" demo.
# Paste a Recall API Key here, not a Workspace Secret / webhook secret.
# If it starts with whsec_, it is the wrong value for API authentication.
RECALL_API_KEY=
# Region of your Recall workspace. Prod runs eu-central-1; match your workspace.
RECALL_API_BASE=https://eu-central-1.recall.ai
# Optional: paste the whsec_ Workspace Secret here if you want this app to
# verify incoming Recall webhook signatures.
RECALL_WEBHOOK_SECRET=
# Live transcription. recallai is fastest but low-latency mode is English-only.
# Use elevenlabs for better multilingual/accent handling after adding the
# ElevenLabs Speech-to-Text key in the Recall transcription dashboard.
RECALL_TRANSCRIPTION_PROVIDER=recallai    # recallai | elevenlabs
RECALL_TRANSCRIPTION_MODE=prioritize_low_latency
RECALL_TRANSCRIPTION_LANGUAGE_CODE=en
ELEVENLABS_TRANSCRIPTION_MODEL=scribe_v2_realtime
ELEVENLABS_TRANSCRIPTION_LANGUAGE_CODE=

# --- Calendar auto-join (optional) ---
# Google OAuth connects Laura's calendar to Recall Calendar V2. In Google Cloud,
# add this redirect URI:  https://YOUR_URL/oauth/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# Optional CSRF token for the OAuth redirect; set any long random string.
CALENDAR_OAUTH_STATE=
# Only meetings that invite one of these emails will schedule an avatar.
# Every avatar is reachable as a plus-alias of this inbox — inviting
# laura.ai.122222+cedric@gmail.com is Cedric's email (same inbox, the +tag
# names the avatar). Bare address / unknown tag = DEFAULT_AVATAR_ID.
CALENDAR_INVITE_EMAILS=laura.ai.122222@gmail.com

# --- Asana (project system of record, optional — docs/ASANA.md) ---
# Personal Access Token: Asana -> Settings -> Apps -> Developer apps.
# A per-org token (store.set_org_oauth provider="asana") overrides this.
ASANA_TOKEN=
# Workspace gid; leave blank to auto-discover from the token.
ASANA_WORKSPACE_GID=
# OAuth app for the dashboard's one-click "Connect Asana" button: create it
# at https://app.asana.com/0/my-apps with redirect URL
# {PUBLIC_BASE_URL}/oauth/asana/callback. Unset = the card shows a
# paste-a-PAT field instead.
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
# Push typed asana.* actions at meeting end WITHOUT dashboard approval.
# Default false = approval-gated (Approve & run on the dashboard).
ASANA_AUTO_EXECUTE=false

# --- Meeting transcription via Granola (POST-MEETING ONLY, optional) ---
# Granola gives finished transcripts of meetings you already recorded with it —
# a keyless-vendor path to the summary/checklist/email WITHOUT Recall/Anam.
# It CANNOT join a call or render an avatar, so it can't power the live agent.
# Key: Granola desktop app → Settings → Connectors → API keys (starts with grn_).
GRANOLA_API_KEY=
GRANOLA_API_BASE=https://api.granola.ai

# --- Face + voice (Anam renders the avatar; ElevenLabs is its voice) ---
# GLOBAL DEFAULTS — a single avatar can override them in its avatar.yaml.
ANAM_API_KEY=
ANAM_AVATAR_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Used when the primary voice can't synthesize (plan tier/licensing). Any
# premade voice id works on the free plan.
ELEVENLABS_FALLBACK_VOICE_ID=

# --- ElevenLabs AGENTS conversation runtime (Cedric-only pilot) ---
# Global kill switch for the per-avatar ElevenLabs Agent runtime. Dispatch
# additionally requires the avatar id in the allowlist AND avatar.yaml opting
# in (conversation_runtime: elevenlabs_agent + a non-empty elevenlabs_agent_id)
# — all four must agree, so one flipped value never moves an avatar's runtime.
# See docs/product/CEDRIC-ELEVENLABS-PILOT.md.
ELEVENLABS_AGENT_RUNTIME_ENABLED=false
ELEVENLABS_AGENT_AVATAR_ALLOWLIST=cedric
# Lingua parlata delle sessioni EL: en (default) | it — saluto localizzato
VOICE_AGENT_LANGUAGE=en

# --- Photoreal avatar (Stage 2, optional; only when AVATAR_PAGE=photoreal) ---
# GPU_STREAM_URL: websocket of the GPU streaming server (gpu/server.py), e.g.
#   wss://gpu.lauravatar.com/stream. Empty = photoreal page shows a static
#   portrait (still speaks). GPU_INSTANCE_ID: an EC2 box the backend starts on
#   session begin and stops GPU_IDLE_STOP_MINUTES after the last session ends
#   (keep it STOPPED, not terminated). Empty = feature off (manual launch only).
GPU_STREAM_URL=
GPU_INSTANCE_ID=
GPU_AWS_REGION=eu-central-1
GPU_IDLE_STOP_MINUTES=10

# --- Public HTTPS URL of THIS server (Recall must reach the webhook + avatar page) ---
# For local live-meeting testing, run `ngrok http 8000` and paste the HTTPS URL.
PUBLIC_BASE_URL=https://your-ngrok-or-deploy-url

# --- Workflow actions (optional — actually send the follow-up email / Slack) ---
# SendGrid ($5k startup credits) for email; Slack incoming webhook for the checklist.
SENDGRID_API_KEY=
MAIL_FROM=
SLACK_WEBHOOK_URL=

# --- Avatar behaviour (GLOBAL DEFAULTS; per-avatar overrides in avatar.yaml) ---
# Laura ALWAYS tracks the whole meeting silently (MeetingState) — the wake word
# only gates whether she SPEAKS. The wake word is optional and configurable:
WAKE_WORDS=laura
# false (default) = she answers any groundable question without her name (the
# in-stream SKIP gate + cooldown keep her from interjecting). true = require her
# name first. Either way the silent tracking + closing intervention still run.
REQUIRE_WAKE_WORD=false
SPEAK_COOLDOWN_SECONDS=8
# LEGACY — no effect on the live streaming path (superseded by the in-stream SKIP
# gate). Kept for back-compat only.
MIN_CONFIDENCE=0.55
# Autopilot (Laura acts between meetings; ALL OFF by default).
# AUTOPILOT_DELIVER=true auto-sends the follow-up email (to AUTOPILOT_DELIVER_TO,
# comma-separated) + Slack summary when a meeting ends. AUTOPILOT_BRIEF=true
# sends the "still open from last time" brief when a known meeting starts.
# AUTOPILOT_NUDGE=true posts a Slack digest of open items every NUDGE_HOURS.
AUTOPILOT_DELIVER=false
AUTOPILOT_DELIVER_TO=
AUTOPILOT_BRIEF=false
AUTOPILOT_BRIEF_TO=
AUTOPILOT_NUDGE=false
AUTOPILOT_NUDGE_HOURS=24

# --- Action execution (canonical Action Control Plane) ---
# Every consequential write is a canonical action: captured live, typed at
# finalize, approved by a human (dashboard or Slack), then executed EXACTLY
# once behind an atomic execution claim. NATIVE_EXECUTOR=true (the default)
# runs approved calendar/gmail/asana actions on the org's own account;
# =false brokers everything through Cedric. There is no autonomous
# execution: approval_required is the policy on every action.
NATIVE_EXECUTOR=true
# Approve doors answer immediately with an observable 'executing' status and
# the vendor call settles done/failed from a worker thread. Default false =
# synchronous execution in-request (the response carries the final status).
ACTION_DISPATCH_ASYNC=false

# --- Avatar Studio (org-personalized avatars — optional) ---
# Per-org overlays on the repo avatars: display identity, tone, greeting,
# voice/face, narrowed tools, Company Brain knowledge scope. Published as
# immutable versions, resolved server-side once per session; an overlay can
# only NARROW what the repo avatar allows, never widen it. Needs
# LAURA_DATABASE_URL; off (default) = repo avatars byte-identical.
ORG_AVATAR_OVERLAYS_ENABLED=false

# --- Company Brain (durable org knowledge — optional) ---
# Org-owned documents ingested into per-org retrieval: upload (or sync a
# Drive folder) -> extract -> chunk -> the avatar cites it in meetings.
# Needs LAURA_DATABASE_URL; everything is inert when off (the default).
COMPANY_BRAIN_ENABLED=false
# Raw uploaded files: S3 bucket via the ambient IAM role. Empty = a local
# directory next to the SQLite store (key-free dev).
KNOWLEDGE_BUCKET=
KNOWLEDGE_S3_ENDPOINT=
KNOWLEDGE_AWS_REGION=eu-central-1
KNOWLEDGE_MAX_FILE_BYTES=10000000
KNOWLEDGE_MAX_EXTRACTED_CHARS=400000
# Recommended durable embedder: EMBEDDING_PROVIDER=openai uses
# text-embedding-3-small at a fixed 512 dims and needs this key. The default
# hash embedder keeps everything key-free.
OPENAI_API_KEY=

# General intelligence on the live path: questions that want fresh/current info
# route to Claude's NATIVE web_search tool (never Groq). Haiku by default keeps
# the spoken answer fast; set claude-sonnet-5 for deeper search when you can wait.
# It falls back to a knowledge answer if search returns nothing. Retrieved docs
# are only injected when they actually match the question (RAG_MIN_CONTEXT_SCORE).
LIVE_SEARCH_ENABLED=true
LIVE_SEARCH_MODEL=claude-haiku-4-5
RAG_MIN_CONTEXT_SCORE=0.10

# Proactive intervention: flag ONE missing step as the meeting wraps up (fires
# once, needs high confidence). Set PROACTIVE_ENABLED=false to disable.
PROACTIVE_ENABLED=true
PROACTIVE_MIN_CONFIDENCE=0.7

# Voice dismissal: "Laura, you can leave" makes her say goodbye and end the
# session (bot leaves the call, artifact is built, billing stops). The grace
# delay lets the goodbye audio finish before the bot disconnects.
LEAVE_ON_COMMAND=true
LEAVE_GRACE_SECONDS=2.5

# --- Server ---
HOST=127.0.0.1
PORT=8000

# ── Cedric integration (fork additions — Cedric X Laura project) ──
# Avatar used when a session/dispatch doesn't name one (set to "cedric").
DEFAULT_AVATAR_ID=laura
# Demo/service bearer required on /sessions/* and /ledger. It is scoped to
# DEMO_ORG_ID and is never a customer-wide provisioning credential.
# Empty = open only for the key-free local demo.
LAURA_API_TOKEN=
# Cedric Slack OAuth bootstrap. This dedicated shared token signs install state,
# authenticates only /dashboard/connections/brain/slack/complete, and is sent
# only to Cedric's /api/laura/orgs bootstrap endpoint. It must differ from
# LAURA_API_TOKEN and never be exposed to browsers.
CEDRIC_ORGS_URL=https://www.meet-cedric.com/api/laura/orgs
CEDRIC_ORGS_TOKEN=
# Production IAM and per-org credential paths:
# docs/infra/CEDRIC-CREDENTIALS.md
# HMAC key + bearer for Demo callbacks POSTed to a session's callback_url
# (match Cedric's LAURA_WEBHOOK_SECRET / LAURA_WEBHOOK_TOKEN).
LAURA_WEBHOOK_SECRET=
LAURA_WEBHOOK_TOKEN=
# Bearer presented when fetching a session's context_url at join time
# (match Cedric's LAURA_CONTEXT_TOKEN).
LAURA_CONTEXT_TOKEN=
# Per-request timeout for outbound callbacks/context fetches (seconds).
CALLBACK_TIMEOUT_SECONDS=10.0
# Default callback for meetings that don't set their own → EVERY meeting
# hands its artifact + live actions to Cedric, who posts the Slack cards
# (orchestrated sessions skip Laura's own AUTOPILOT_* notetaker). Execution
# follows each action's stamped route: NATIVE_EXECUTOR runs typed
# calendar/gmail/asana actions on the org's own account after approval;
# cedric-routed actions execute through Cedric's tools. Unset just means no
# orchestrator hand-off. Point at Cedric's receiver, e.g.
# https://www.meet-cedric.com/api/laura/events
SURFACE_WEBHOOK_URL=
# Pre-meeting context (Cedric → Laura): default context_url so the avatar pulls
# "who's who + context" from Cedric's memory at join. Point at Cedric's
# context endpoint, e.g. https://meet-cedric.com/api/laura/context
SURFACE_CONTEXT_URL=

# ─────────────────── Tenancy policy (personal-first) ──────────────────
# Personal-first (owner decision, 2026-07-13/re-confirmed 2026-07-16): every
# login gets its OWN durable org — colleagues on the same verified corporate
# domain are NOT auto-grouped. Set true to restore the parked domain→shared
# "teams" routing. Honored by BOTH the SQLite mirror and the durable
# ensure_user (synced at boot into laura_private.policy_settings). Default off.
LAURA_SHARED_DOMAIN_ORGS=false

# --- Data Foundation (DF0-DF1 — optional, accepted contract v5) ---
# Normalized company data over connectors with fail-closed mirrored ACLs,
# lineage and the ContextResolver. Off (default) = tables inert, retrieval
# byte-identical. Rollout: alembic 0012 -> this flag -> upload backfill ->
# per-org Drive opt-in. Rollback = flag off.
DATA_FOUNDATION_ENABLED=false

# ─────────────────── Browser operator (Sable B0) — optional ───────────────────
# A Laura avatar opens and operates a remote browser for a watched product
# demo behind a read-only live view. Default OFF; with no keys everything
# no-ops and the demo is unchanged. B0 uses a deterministic FAKE provider;
# the real Browserbase adapter is a SEPARATE flag and stays off without keys.
# Guarded write clicks (submit/purchase/send/...) go through the SAME approval
# plane as every other action (route='browser'); B0 ships read-only.
# docs/product/LAURA-SABLE-BROWSER-OPERATOR-IMPLEMENTATION.md + the B0 report.
BROWSER_OPERATOR_ENABLED=false
BROWSER_PROVIDER=browserbase
BROWSER_REAL_PROVIDER_ENABLED=false
BROWSER_OPERATOR_URL=
BROWSER_OPERATOR_TOKEN=
BROWSER_OPERATOR_CALLBACK_SECRET=
BROWSER_DEFAULT_TIMEOUT_SECONDS=1800
BROWSER_MAX_STEPS=30
BROWSER_PRESENTATION_TOKEN_TTL_SECONDS=120
BROWSER_ALLOW_WRITES=false
# Real-provider credentials (only when BROWSER_REAL_PROVIDER_ENABLED=true):
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ─────────── Pipedream Connect — alternative connections tab (OPTIONAL) ──────
# Experimental "Pipedream" dashboard tab that brokers account connections +
# pre-built actions through Pipedream Connect. INERT unless project + client
# creds are all set. Server auth is client-credentials (client_id/secret → 1h
# token); the connect flow is the hosted Connect Link (redirect). Find the
# project ID + create an OAuth client in your Pipedream project's API settings.
PIPEDREAM_PROJECT_ID=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_ENVIRONMENT=development
# PIPEDREAM_API_BASE=https://api.pipedream.com/v1

# ───────── OpenClaw full executor experiment (dev/test only) ─────────
# OFF unless BOTH the global flag is true and the org id is allowlisted.
# Active orgs route post-meeting actions to OpenClaw and suppress Laura's
# native/Pipedream/Cedric/browser executors to prevent duplicate writes.
OPENCLAW_EXPERIMENT_ENABLED=false
OPENCLAW_EXPERIMENT_ORGS=
OPENCLAW_AUTO_RUN=false
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=laura-executor-test
OPENCLAW_BROWSER_ENABLED=true

# ─────────────────── Browser B1 "Visual Eyes" — optional ───────────────────
# Screenshot-driven perception: a multimodal planner reads a screenshot +
# sanitized structure and proposes ONE typed operation; the deterministic B0
# policy stays authoritative. Default OFF ⇒ inert, B0 byte-identical. The real
# remote browser + real model are exercised ONLY by the credential-gated smoke
# (backend/scripts/browser_b1_smoke.py); until then real perception is UNPROVEN.
# docs/product/BROWSER-B1-VISUAL-EYES.md.
BROWSER_VISUAL_PLANNER_ENABLED=false
BROWSER_PLANNER_PROVIDER=openai
BROWSER_PLANNER_MODEL=gpt-5-computer-use
BROWSER_PLANNER_TIMEOUT_SECONDS=20
BROWSER_PLANNER_MAX_RETRIES=2
BROWSER_SCREENSHOT_MAX_BYTES=1500000
BROWSER_SCREENSHOT_MAX_DIMENSION=1280
BROWSER_COORDINATE_CONFIDENCE_THRESHOLD=0.6
BROWSER_ALLOWED_DOMAINS=demo.laura.test
BROWSER_COORD_MAX_STEPS=12
BROWSER_COORD_MAX_CONSECUTIVE_FAILURES=3
BROWSER_COORD_MAX_REPLANS=4
BROWSER_COORD_MAX_DURATION_SECONDS=120
BROWSER_COORD_MAX_MODEL_CALLS=16

# ─────────────────── Northstar MVP demo (final integration) ───────────────────
# Wires Browser B1 + ContextResolver + the Northstar synthetic product into a
# meeting-bound demo. Default OFF ⇒ the demo router 404s, the northstar browser
# provider is never selected, production behaviour is byte-identical. Needs the
# browser operator + control plane on. docs/product/NORTHSTAR-MVP.md.
NORTHSTAR_DEMO_ENABLED=false
# The ONE controlled synthetic write (the Acme follow-up task). Arbitrary
# browser writes stay disabled (BROWSER_ALLOW_WRITES=false); this narrow flag
# enables ONLY the follow-up to be minted as a canonical action and executed
# on approval.
NORTHSTAR_DEMO_WRITE_ENABLED=false
