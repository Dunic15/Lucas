# ─────────────────────────────────────────────────────────────
# Callable AI Process Avatar — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# --- Reasoning (the brain) ---
ANTHROPIC_API_KEY=sk-ant-...
BRAIN_MODEL=claude-sonnet-4-6          # fast model for real-time meeting answers

# --- Embeddings (for RAG retrieval over process docs) ---
# Voyage is the default. Get a key at https://www.voyageai.com/
VOYAGE_API_KEY=pa-...
EMBEDDING_MODEL=voyage-3

# --- Meeting entry / ears (Recall.ai) ---
RECALL_API_KEY=...
# Region base URL, e.g. https://us-west-2.recall.ai  (see your Recall dashboard)
RECALL_API_BASE=https://us-west-2.recall.ai

# --- Face + voice (Tavus renders the avatar; ElevenLabs is its voice) ---
TAVUS_API_KEY=...
# A Tavus replica (stock or custom). Find/create in the Tavus dashboard.
TAVUS_REPLICA_ID=r...
# Optional: reuse an existing persona instead of creating one each session.
TAVUS_PERSONA_ID=

# --- Voice (ElevenLabs) ---
# The voice the Tavus avatar speaks with. ElevenLabs voice id.
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# --- Public URL of THIS server (Recall must reach the webhook + avatar page) ---
# In dev use an ngrok https URL, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=https://your-ngrok-or-deploy-url

# --- Avatar behaviour ---
# Comma-separated names that "call" the avatar into the conversation.
WAKE_WORDS=sofia
# Seconds the avatar stays quiet after speaking, to avoid talking over people.
SPEAK_COOLDOWN_SECONDS=8
# Minimum model confidence (0-1) required before the avatar speaks.
MIN_CONFIDENCE=0.55

# --- Server ---
HOST=127.0.0.1
PORT=8000
