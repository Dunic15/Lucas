# ─────────────────────────────────────────────────────────────
# Callable AI Process Avatar — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# --- Reasoning (the brain) ---
ANTHROPIC_API_KEY=sk-ant-...
BRAIN_MODEL=claude-sonnet-4-6          # fast model for real-time meeting answers

# --- Embeddings (for RAG retrieval over process docs) ---
# Voyage is the default. Get a key at https://www.voyageai.com/
VOYAGE_API_KEY=pa-...
EMBEDDING_MODEL=voyage-3

# --- Meeting entry / ears (Recall.ai) ---
RECALL_API_KEY=...
# Region base URL, e.g. https://us-west-2.recall.ai  (see your Recall dashboard)
RECALL_API_BASE=https://us-west-2.recall.ai

# --- Face + voice (Anam renders and voices the avatar) ---
# These are GLOBAL DEFAULTS. Sofia can override them in
# avatars/sofia/avatar.yaml (anam_avatar_id / anam_avatar_model / anam_voice_id).
ANAM_API_KEY=...
# Find/create these in Anam Lab.
ANAM_AVATAR_ID=...
ANAM_AVATAR_MODEL=cara-4
# Prefer an ElevenLabs-backed voice in Anam Lab. If you have an ElevenLabs
# custom voice, import it into Anam first, then put the Anam voice id here.
ANAM_VOICE_ID=...
# Client-side LLM mode: our backend decides answers and the page calls talk().
ANAM_LLM_ID=CUSTOMER_CLIENT_V1

# Optional ElevenLabs voice tuning passed through Anam.
# Use only when ANAM_VOICE_ID points to an ElevenLabs v1/v2 voice.
# ANAM_VOICE_STABILITY=0.45
# ANAM_VOICE_SIMILARITY_BOOST=0.8
# ANAM_VOICE_SPEED=1.0
# ANAM_VOICE_USE_SPEAKER_BOOST=true
# ANAM_VOICE_STYLE=0.0

# --- Public URL of THIS server (Recall must reach the webhook + avatar page) ---
# In dev use an ngrok https URL, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=https://your-ngrok-or-deploy-url

# --- Avatar behaviour (GLOBAL DEFAULTS) ---
# Sofia can override these in avatars/sofia/avatar.yaml.
# Fallback wake word(s) if an avatar doesn't set its own (comma-separated).
WAKE_WORDS=sofia
# Seconds the avatar stays quiet after speaking, to avoid talking over people.
SPEAK_COOLDOWN_SECONDS=8
# Minimum model confidence (0-1) required before the avatar speaks.
MIN_CONFIDENCE=0.55

# --- Server ---
HOST=127.0.0.1
PORT=8000
